{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "rac-menengai.vercel.app"
        }
      ],
      "dest": "https://rotaractmenengai.org/$1",
      "status": 308
    },
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://clerk.rotaractmenengai.org https://*.clerk.accounts.dev https://challenges.cloudflare.com https://*.protect.clerk.com https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://vercel.live; img-src 'self' data: blob: https://img.clerk.com https://*.clerk.com https://vercel.live https://vercel.com; font-src 'self' https://clerk.rotaractmenengai.org https://*.clerk.accounts.dev https://fonts.gstatic.com https://vercel.live https://assets.vercel.com; connect-src 'self' https://clerk.rotaractmenengai.org https://*.clerk.accounts.dev https://*.protect.clerk.com:* https://challenges.cloudflare.com https://vercel.live wss://ws-us3.pusher.com; frame-src https://www.youtube-nocookie.com https://clerk.rotaractmenengai.org https://*.clerk.accounts.dev https://challenges.cloudflare.com https://*.protect.clerk.com https://vercel.live; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "^/api/orientation/?$",
      "dest": "/api/orientation"
    },
    {
      "src": "^/api/academy/?$",
      "dest": "/api/academy"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/about/?$",
      "dest": "/about/index.html"
    },
    {
      "src": "^/about/district-9215/?$",
      "dest": "/about/district-9215/index.html"
    },
    {
      "src": "^/rotary/?$",
      "dest": "/rotary/index.html"
    },
    {
      "src": "^/learn/?$",
      "dest": "/learn/index.html"
    },
    {
      "src": "^/projects/?$",
      "dest": "/projects/index.html"
    },
    {
      "src": "^/awards/?$",
      "dest": "/awards/index.html"
    },
    {
      "src": "^/leadership/?$",
      "dest": "/leadership/index.html"
    },
    {
      "src": "^/events/nakuru-region-drr-hyrax-hill/?$",
      "dest": "/events/nakuru-region-drr-hyrax-hill/index.html"
    },
    {
      "src": "^/events/nakuru-region-district-governor-meeting-inductions/?$",
      "dest": "/events/nakuru-region-district-governor-meeting-inductions/index.html"
    },
    {
      "src": "^/events/india-friendship-exchange-2026/?$",
