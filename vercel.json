{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "^/api/orientation/?$",
      "dest": "/api/orientation"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/about/?$",
      "dest": "/about/index.html"
    },
    {
      "src": "^/about/district-9215/?$",
      "dest": "/about/district-9215/index.html"
    },
    {
      "src": "^/rotary/?$",
      "dest": "/rotary/index.html"
    },
    {
      "src": "^/learn/?$",
      "dest": "/learn/index.html"
    },
    {
      "src": "^/projects/?$",
      "dest": "/projects/index.html"
    },
    {
      "src": "^/awards/?$",
      "dest": "/awards/index.html"
    },
    {
      "src": "^/leadership/?$",
      "dest": "/leadership/index.html"
    },
    {
      "src": "^/events/?$",
      "dest": "/events/index.html"
    },
    {
      "src": "^/membership/?$",
      "dest": "/membership/index.html"
    },
    {
      "src": "^/membership/orientation/?$",
      "dest": "/membership/orientation/index.html"
    },
    {
      "src": "^/contact/?$",
      "dest": "/contact/index.html"
    },
    {
      "src": "^/partnerships/?$",
      "dest": "/partnerships/index.html"
    },
    {
      "src": "^/privacy/?$",
      "dest": "/privacy/index.html"
    },
    {
      "src": "^/projects/pangani-special-school/?$",
      "dest": "/projects/pangani-special-school/index.html"
    },
    {
      "src": "^/projects/book-club/?$",
      "dest": "/projects/book-club/index.html"
    },
    {
      "src": "^/projects/mother-packs/?$",
      "dest": "/projects/mother-packs/index.html"
    },
    {
      "src": "^/projects/limuko-girls/?$",
      "dest": "/projects/limuko-girls/index.html"
    },
    {
      "src": "^/events/presidential-installation-june-2026/?$",
      "dest": "/events/presidential-installation-june-2026/index.html"
    },
    {
      "src": "^/events/mother-pack-bondeni-july-2026/?$",
      "dest": "/events/mother-pack-bondeni-july-2026/index.html"
    },
    {
      "src": "^/events/mother-pack-kabatini-august-2026/?$",
      "dest": "/events/mother-pack-kabatini-august-2026/index.html"
    },
    {
      "src": "^/events/art-day-pangani-2026/?$",
      "dest": "/events/art-day-pangani-2026/index.html"
    },
    {
      "src": "^/events/new-member-induction-2026/?$",
      "dest": "/events/new-member-induction-2026/index.html"
    },
    {
      "src": "^/events/mazingira-day-pangani-2026/?$",
      "dest": "/events/mazingira-day-pangani-2026/index.html"
    },
    {
      "src": "^/events/book-club-camping-affair-2026/?$",
      "dest": "/events/book-club-camping-affair-2026/index.html"
    },
    {
      "src": "^/events/medical-camp-2026/?$",
      "dest": "/events/medical-camp-2026/index.html"
    },
    {
      "src": "^/404/?$",
      "dest": "/404.html",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
