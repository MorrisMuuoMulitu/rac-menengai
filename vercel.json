{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/about/?$",
      "dest": "/about/index.html"
    },
    {
      "src": "^/about/district-9215/?$",
      "dest": "/about/district-9215/index.html"
    },
    {
      "src": "^/rotary/?$",
      "dest": "/rotary/index.html"
    },
    {
      "src": "^/projects/?$",
      "dest": "/projects/index.html"
    },
    {
      "src": "^/awards/?$",
      "dest": "/awards/index.html"
    },
    {
      "src": "^/leadership/?$",
      "dest": "/leadership/index.html"
    },
    {
      "src": "^/news/?$",
      "dest": "/news/index.html"
    },
    {
      "src": "^/events/?$",
      "dest": "/events/index.html"
    },
    {
      "src": "^/membership/?$",
      "dest": "/membership/index.html"
    },
    {
      "src": "^/membership/orientation/?$",
      "dest": "/membership/orientation/index.html"
    },
    {
      "src": "^/contact/?$",
      "dest": "/contact/index.html"
    },
    {
      "src": "^/partnerships/?$",
      "dest": "/partnerships/index.html"
    },
    {
      "src": "^/privacy/?$",
      "dest": "/privacy/index.html"
    },
    {
      "src": "^/projects/adopt-a-river/?$",
      "dest": "/projects/adopt-a-river/index.html"
    },
    {
      "src": "^/projects/mother-packs/?$",
      "dest": "/projects/mother-packs/index.html"
    },
    {
      "src": "^/projects/limuko-girls/?$",
      "dest": "/projects/limuko-girls/index.html"
    },
    {
      "src": "^/projects/ndarugu-cleanup/?$",
      "dest": "/projects/ndarugu-cleanup/index.html"
    },
    {
      "src": "^/projects/peace-fest/?$",
      "dest": "/projects/peace-fest/index.html"
    },
    {
      "src": "^/projects/street-families/?$",
      "dest": "/projects/street-families/index.html"
    },
    {
      "src": "^/news/peace-in-colour-nakuru/?$",
      "dest": "/news/peace-in-colour-nakuru/index.html"
    },
    {
      "src": "^/news/nakuru-city-cleanup/?$",
      "dest": "/news/nakuru-city-cleanup/index.html"
    },
    {
      "src": "^/events/peace-in-colour-2025/?$",
      "dest": "/events/peace-in-colour-2025/index.html"
    },
    {
      "src": "^/404/?$",
      "dest": "/404.html",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
