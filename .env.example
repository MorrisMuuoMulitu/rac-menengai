# Keep false until a real delivery test and privacy/retention review are complete.
VITE_CONTACT_DELIVERY=false
SITE_ORIGIN=https://rotaractmenengai.org
# Server-only credentials. Never prefix secrets with VITE_.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=menengairc@gmail.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only course access. Generate a passcode of at least 12 characters and
# an independent random session secret of at least 32 characters.
ORIENTATION_PASSCODE=
ORIENTATION_SESSION_SECRET=

# Membership academy. The course reads without any of these; saving progress,
# marking the assessment and recording an officer decision need all of them.
# Pooled connection for the app, unpooled only for schema work.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Clerk secret key from the Vercel Marketplace integration.
CLERK_SECRET_KEY=
# Comma-separated. An officer is recognised by the verified email on their
# signed-in account — never by anything the browser sends.
ACADEMY_REVIEWER_EMAILS=morrismulitu@gmail.com

# Sanity Free. The read token is optional; the write token is only needed for
# `npm run sanity:push` and must never be given to the front end.
SANITY_API_PROJECT_ID=
SANITY_API_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Public. Safe to expose; it is the browser half of the sign-in integration.
VITE_CLERK_PUBLISHABLE_KEY=
