{
  "name": "rac-menengai",
  "private": true,
  "version": "3.0.0",
  "description": "Rotaract Club of Menengai — Service Above Self. Multi-page React + Vite + TypeScript site: About, Projects, Awards, Leadership, News, Membership, Contact.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-functions.mjs && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "test": "vitest run",
    "preview": "vite preview --port 8080",
    "serve": "vite preview --port 8080 --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/prepare-content.mjs",
    "prebuild": "node scripts/prepare-content.mjs",
    "verify": "npm test && npm run build && node scripts/verify-build.mjs",
    "seo:submit": "node scripts/submit-indexnow.mjs --submit",
    "sanity:build": "vite build --ssr scripts/sanity-seed.ts --outDir .sanity-seed",
    "sanity:check": "npm run sanity:build && node scripts/import-sanity.mjs",
    "sanity:push": "npm run sanity:build && node scripts/import-sanity.mjs --apply",
    "academy:sources": "vite build --ssr shared/rotaract-academy/sources.ts --outDir .sources && node scripts/write-source-register.mjs",
    "format": "prettier --write src api scripts content index.html vercel.json vite.config.ts",
    "pretest": "node scripts/prepare-content.mjs",
    "pretypecheck": "node scripts/prepare-content.mjs",
    "verify:scroll": "node scripts/verify-scroll.mjs && node scripts/verify-scroll.py --dir docs/audit/scroll-check",
    "verify:dns": "node scripts/verify-dns.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.24.0",
    "@clerk/react": "^6.17.8",
    "@sanity/client": "^8.9.0",
    "@vercel/functions": "^3.10.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.469.0",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.1"
  }
}
